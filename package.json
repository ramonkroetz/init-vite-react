{
  "name": "init-vite-react",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "prebuild": "npm run lingui:extract:compile:strict && npm run lint",
    "build": "tsc -b && vite build",
    "build:dev": "./node_modules/.bin/env-cmd -f .env.dev -- npm run build",
    "build:stage": "./node_modules/.bin/env-cmd -f .env.stage -- npm run build",
    "build:production": "./node_modules/.bin/env-cmd -f .env.prod -- npm run build",
    "dev": "npm run lingui:extract:compile && ./node_modules/.bin/env-cmd -f .env.dev -- vite --open",
    "preview": "npm run build:dev && vite preview",
    "lint": "npm run lint:node && npm run lint:biome && npm run lint:ts",
    "lint:node": "npx --yes is-my-node-vulnerable",
    "lint:biome": "biome check . && biome lint --error-on-warnings .",
    "lint:ts": "tsc -p tsconfig.json --noEmit",
    "lingui:extract:compile": "lingui extract --clean && lingui compile",
    "lingui:extract:compile:strict": "lingui extract --clean && lingui compile --strict",
    "biome:format": "biome check --write .",
    "preinstall:supported:browsers": "chmod +x scripts/generateSupportedBrowsers.sh",
    "supported:browsers": "./scripts/generateSupportedBrowsers.sh",
    "analyze": "vite-bundle-visualizer --output dist/stats.html --open",
    "opencode": "npm exec opencode -- .",
    "commit": "npm exec opencode -- run --command commit",
    "translate": "npm exec opencode -- run --command translate"
  },
  "dependencies": {
    "@generouted/react-router": "1.20.2",
    "@lingui/core": "6.3.0",
    "@lingui/react": "6.3.0",
    "@tanstack/react-query": "5.90.16",
    "classnames": "2.5.1",
    "client-error-logger": "github:ramonkroetz/client-error-logger#v2.0.0",
    "js-cookie": "3.0.7",
    "react": "19.2.8",
    "react-dialogs": "github:ramonkroetz/react-dialogs#v2.0.0",
    "react-dom": "19.2.8",
    "react-router": "8.3.0",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@biomejs/biome": "2.4.12",
    "@lingui/babel-plugin-lingui-macro": "6.3.0",
    "@lingui/format-po": "6.3.0",
    "@lingui/vite-plugin": "6.6.0",
    "@rolldown/plugin-babel": "0.2.3",
    "@types/babel__traverse": "7.28.0",
    "@types/js-cookie": "3.0.6",
    "@types/node": "24.10.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "6.0.4",
    "babel-plugin-react-compiler": "1.0.0",
    "browserslist-useragent-regexp": "4.1.3",
    "env-cmd": "11.0.0",
    "opencode-ai": "1.18.9",
    "sharp": "0.35.2",
    "svgo": "4.0.2",
    "tsx": "4.22.4",
    "typescript": "5.9.3",
    "vite": "8.1.5",
    "vite-bundle-visualizer": "1.2.1",
    "vite-imagetools": "10.0.1",
    "vite-plugin-image-optimizer": "2.0.3",
    "vite-plugin-pwa": "1.3.0",
    "vite-plugin-radar": "0.11.0",
    "vite-plugin-svgr": "5.2.0"
  },
  "overrides": {
    "ejs": "5.0.1"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true,
    "sharp@0.35.2": true,
    "opencode-ai@1.18.9": true
  }
}
